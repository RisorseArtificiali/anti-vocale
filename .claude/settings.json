{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check-sherpa-sync.sh 2>/dev/null || echo 'WARNING: sherpa version out of sync (see .sherpa-version, scripts/fetch-sherpa-aar.sh, app/build.gradle.kts SRCLIB PIN)'",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/check-strings-escapes.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/block-raw-release-dispatch.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}