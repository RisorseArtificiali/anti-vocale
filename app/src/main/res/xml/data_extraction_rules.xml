<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-845 (maintainer decision 2026-10-14, option three of the allowBackup
     assessment): the preferences directory (which carries the remote-offload
     bearer API key and the whole DataStore set: localai_preferences,
     transcription_calibration) never rides the OS CLOUD backup; the Room
     database (transcripts) stays recoverable. Device-transfer (the local
     D2D migration, under the user's physical control) keeps everything, so
     a phone migration loses nothing. Directory-level on purpose: future
     DataStores land inside datastore/ and are covered without a rule edit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
    </device-transfer>
</data-extraction-rules>
