            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.AntiVocale">
        </activity>

        <!-- Launcher icon variants: the MAIN/LAUNCHER filter lives on these
             aliases, not on MainActivity. Exactly one is enabled:
             LauncherDefault ships enabled, LauncherIconManager switches the
             set via setComponentEnabledSetting (component state persists
             across app updates, so an update keeps the user's choice; a
             retired alias is healed back to Default at
             startup by LauncherIconManager). Labels stay the app name on purpose: the icon is the
             differentiator. Explicit starts of MainActivity (notifications,
             Tasker) are class intents and do not need the filter. Alias
             names are a pinned contract: LauncherIconManager +
             LauncherIconManifestTest. -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- derei's icon concepts (GH #61, TASK-473): raster foreground layers
             over the shared gradient, one alias per concept. -->
        <activity-alias
            android:name=".LauncherWavecut"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_derei_wavecut"
