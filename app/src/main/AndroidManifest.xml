<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No storage permissions: model import, audio share, and audio picker all use
         the Storage Access Framework (OpenDocument) or share-intent content URIs,
         which grant their own read access. See TASK-301. -->

    <!-- Foreground service for inference -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package visibility (Android 11+): see every app that can share audio with us,
         so AppInfoUtils can resolve real app labels for the Logs grouping even after
         the automatic recent-interaction window closes (TASK-320: Google Files showed
         as its raw package name otherwise). -->
    <queries>
        <!-- Broadest: every app with a share (SEND) intent filter. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
        </intent>
        <!-- Plus explicit audio matches for SEND_MULTIPLE, which the data-less
             query above does not cover. -->
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="audio/*" />
        </intent>
        <!-- Feedback mailto (TASK-341): without this query, package visibility
             filtering makes resolveActivity return null for SENDTO/mailto on
             API 30+ even when a mail app is installed, so the feedback row
             would always fall back to clipboard. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- TASK-336: OEMs (ColorOS UserAwareMgr verified on device) kill the process mid-transcription
         even with a running foreground service; the standard Play-acceptable exemption request
         for core background-function apps is the battery-optimization whitelist. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TASK-375: optional, mirrors Google AI Edge Gallery; documents NNAPI usage in
         device metadata without affecting Play filtering (required=false; CPU is the
         fallback and the NNAPI provider is auto-reset on native crash, issue #26). -->
    <uses-feature android:name="android.hardware.npu" android:required="false" />

