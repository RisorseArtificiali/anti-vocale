<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-409: test SPI overlay, DEBUG BUILDS ONLY (both flavors).
     A build-type overlay is merged solely into the debug variants, so release
     builds of playStore AND fdroid contain neither the receiver nor the
     TEST_SPI intent filter. The receiver additionally refuses to run unless
     BuildConfig.DEBUG. The broadcast is exported with NO permission: any app
     on a test device can read or flip the app's preferences through it, which
     is acceptable only because debug builds are never distributed. See
     docs/testing-spi.md; the production exported receivers are reviewed in
     docs/research/2026-09-03_tasker-receiver-security-analysis.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:usesCleartextTraffic="true">

        <!-- TASK-550 device pass: the SPI import op and the catalog override
             point at a local http server (adb reverse); debug builds only. -->

        <!-- BroadcastReceiver for the debug-only test SPI -->
        <receiver
            android:name=".receiver.TestSpiReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.antivocale.app.TEST_SPI" />
            </intent-filter>
        </receiver>

        <!-- Lint quirk workaround (TASK-269 round): once an overlay
             declares ANY <service>, lint resolves startForeground call
             sites against the overlay manifest and reports false
             ForegroundServiceType errors on the MAIN services. Re-asserting
             the two real declarations satisfies the lookup. tools:replace
             makes this value WIN the merge (plain merge would union it into
             a duplicated token); that also means these values MUST mirror
             main's declarations, pinned by FgsTypeMirrorTest. Re-probe lint
             after any AGP bump and delete this block if the false errors
             are gone. -->
        <service android:name=".service.InferenceService" android:foregroundServiceType="specialUse" tools:node="merge" tools:replace="android:foregroundServiceType" />
        <service android:name=".service.ExtractionService" android:foregroundServiceType="specialUse" tools:node="merge" tools:replace="android:foregroundServiceType" />

        <!-- TASK-269 spike: debug-only observation listener (metadata only);
             enable command and design rationale in VoiceNoteListenerSpike's
             KDoc. exported=false per the official NotificationListenerService
             sample: only the system binds, the signature permission is the
             real gate. -->
        <service
            android:name=".spike.VoiceNoteListenerSpike"
            android:exported="false"
            android:label="Voice note spike (debug)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
